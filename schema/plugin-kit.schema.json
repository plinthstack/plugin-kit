{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://raw.githubusercontent.com/plinthstack/plugin-kit/main/schema/plugin-kit.schema.json",
	"title": "plugin-kit.json",
	"type": "object",
	"additionalProperties": false,
	"required": [ "slug", "name", "namespace", "prefix", "text_domain", "requires_wp", "requires_php", "tested_up_to", "tier" ],
	"properties": {
		"$schema": { "type": "string" },
		"slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
		"name": { "type": "string", "minLength": 1 },
		"namespace": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*(\\\\[A-Z][A-Za-z0-9]*)*$" },
		"prefix": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
		"text_domain": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
		"requires_wp": { "$ref": "#/definitions/version" },
		"requires_php": { "$ref": "#/definitions/version" },
		"tested_up_to": { "$ref": "#/definitions/version" },
		"tier": { "enum": [ "free", "premium" ] }
	},
	"definitions": {
		"version": { "type": "string", "pattern": "^\\d+\\.\\d+$" }
	}
}
