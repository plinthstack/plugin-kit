<?xml version="1.0"?>
<ruleset name="PlinthStack Demo">
	<rule ref="../../phpcs/ruleset.xml"/>

	<config name="minimum_wp_version" value="6.7"/>
	<config name="text_domain" value="plinthstack-demo"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="plinthstack_demo"/>
			</property>
		</properties>
	</rule>
</ruleset>
