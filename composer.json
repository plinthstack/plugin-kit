{
	"name": "plinthstack/plugin-kit",
	"description": "Shared tooling and scaffold for PlinthStack WordPress plugins.",
	"type": "library",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/plinthstack/plugin-kit",
	"support": {
		"issues": "https://github.com/plinthstack/plugin-kit/issues",
		"source": "https://github.com/plinthstack/plugin-kit"
	},
	"require": {
		"php": ">=8.1",
		"automattic/vipwpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"justinrainbow/json-schema": "^6.14",
		"php-stubs/wordpress-tests-stubs": "^7.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1.8 || ^3.0@alpha",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.3",
		"phpstan/phpstan-phpunit": "^2.1",
		"squizlabs/php_codesniffer": "^3.13",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.4"
	},
	"autoload": {
		"psr-4": {
			"PlinthStack\\PluginKit\\": "src/"
		}
	},
	"bin": [
		"bin/plugin-kit"
	],
	"scripts": {
		"test": "tests/fixtures.sh"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	}
}
