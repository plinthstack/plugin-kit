{
	"name": "plinthstack/plugin-kit",
	"description": "Shared tooling and scaffold for PlinthStack WordPress plugins.",
	"type": "library",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/plinthstack/plugin-kit",
	"support": {
		"issues": "https://github.com/plinthstack/plugin-kit/issues",
		"source": "https://github.com/plinthstack/plugin-kit"
	},
	"require": {
		"php": ">=8.1",
		"justinrainbow/json-schema": "^6.14"
	},
	"autoload": {
		"psr-4": {
			"PlinthStack\\PluginKit\\": "src/"
		}
	},
	"bin": [
		"bin/plugin-kit"
