<?xml version="1.0"?>
<ruleset name="PlinthStack Plugin Kit">
	<description>WordPress and VIP coding standards with PHP compatibility, shared by PlinthStack plugins.</description>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<rule ref="WordPress"/>
	<rule ref="WordPress-VIP-Go"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- VIP turns these off; Plugin Check, which wordpress.org runs, does not. -->
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<severity>5</severity>
	</rule>
	<rule ref="Generic.PHP.DisallowShortOpenTag.EchoFound">
		<severity>5</severity>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_readfile">
		<severity>5</severity>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fclose">
		<severity>5</severity>
	</rule>

	<!-- PSR-4 names the file after its class, which these two sniffs reject. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/inc/classes/*</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>*/inc/classes/*</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Test fixtures are tiny classes that only make sense beside the test that uses them. -->
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
</ruleset>
